{
  "name": "kage-vpn",
  "version": "0.1.0",
  "description": "Kage VPN, a macOS menu bar manager for sing-box",
  "homepage": "https://shashi-madushan.github.io/KageVPN/",
  "repository": { "type": "git", "url": "https://github.com/Shashi-Madushan/KageVPN.git" },
  "bugs": { "url": "https://github.com/Shashi-Madushan/KageVPN/issues" },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:app": "tauri build --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "release": "node scripts/release.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "screenshots": "UPDATE_FIXTURES=1 cargo test --manifest-path src-tauri/Cargo.toml demo_protocols_fixture -q && node scripts/screenshots/capture.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "playwright-core": "^1.63.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
