{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kage",
  "version": "0.2.0",
  "identifier": "com.apzur.kage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kage",
        "width": 960,
        "height": 620,
        "minWidth": 520,
        "visible": false,
        "label": "main",
        "create": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        },
        "minHeight": 480
      },
      {
        "label": "tray",
        "create": false,
        "url": "/tray",
        "width": 320,
        "height": 550,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": true,
        "focus": false,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "kagevpn"
        ]
      }
    }
  }
}